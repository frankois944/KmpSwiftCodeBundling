root = true

[*]
charset = utf-8
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# ktlint allows 140 by default and rejoins shorter lines, which then trips detekt's 120. Both tools
# read this, so it is the one place that keeps them from undoing each other.
[*.{kt,kts}]
max_line_length = 120

[*{.yml,yaml}]
indent_style = space
indent_size = 2
